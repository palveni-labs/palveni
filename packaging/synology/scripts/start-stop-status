#!/bin/sh
set -eu
umask 077

: "${SYNOPKG_PKGDEST:?}" "${SYNOPKG_PKGVAR:?}" "${SYNOPKG_PKGTMP:?}"
[ "$(id -u)" != 0 ] || { echo "Use the DSM package account." >&2; exit 1; }
server="$SYNOPKG_PKGDEST/bin/palveni"
run="$SYNOPKG_PKGTMP/service"
pidfile="$run/pid"
export PALVENI_DATA_DIR="$SYNOPKG_PKGVAR/data"
export PALVENI_FFMPEG_PATH="$SYNOPKG_PKGDEST/bin"
port=${PALVENI_PORT:-7258}

# Match both the executable and the process birth time before sending any signal.
birth() { awk '{print $22}' "/proc/$1/stat" 2>/dev/null; }
owned() {
    case "$pid" in ''|0|*[!0-9]*) return 1;; esac
    [ -n "$stamp" ] && [ "$server" -ef "/proc/$pid/exe" ] && [ "$(birth "$pid")" = "$stamp" ]
}

recorded() {
    pid= stamp=
    [ -f "$pidfile" ] && read -r pid stamp < "$pidfile" && owned
}

case "${1:-}" in
status)
    recorded && exit 0
    [ ! -e "$pidfile" ] || exit 1
    exit 3 ;;
start|stop) ;;
*) exit 1 ;;
esac

mkdir -p "$run"
# Linux releases the lock on exit, including interrupted package operations.
exec 9>"$run/control.lock"
flock -w 45 9 || { echo "Another package operation is still active." >&2; exit 1; }

if [ "$1" = stop ]; then
    if recorded; then
        kill -TERM "$pid" || ! owned || exit 1
        remaining=30
        while owned; do
            [ "$remaining" -gt 0 ] || { echo "Service did not stop." >&2; exit 1; }
            sleep 1
            remaining=$((remaining - 1))
        done
    fi
    rm -f "$pidfile"
    exit 0
fi

recorded && exit 0
url="http://127.0.0.1:$port/api/v1/system/health"
if curl --noproxy '*' -s --max-time 1 "$url" -o /dev/null; then
    echo "Port $port is already in use." >&2
    exit 1
fi
mkdir -p "$PALVENI_DATA_DIR"
cd "$PALVENI_DATA_DIR"
"$server" serve </dev/null >"$run/server.log" 2>&1 9>&- &
pid=$!
stamp=$(birth "$pid") || { echo "Service exited during startup." >&2; exit 1; }
printf '%s %s\n' "$pid" "$stamp" >"$pidfile.new"
mv "$pidfile.new" "$pidfile"

remaining=45
while [ "$remaining" -gt 0 ]; do
    if owned && curl --noproxy '*' -fsS --max-time 1 "$url" >/dev/null 2>&1; then
        exit 0
    fi
    kill -0 "$pid" 2>/dev/null || break
    sleep 1
    remaining=$((remaining - 1))
done
if owned; then kill -TERM "$pid"; fi
echo "Service did not become ready. See $run/server.log" >&2
exit 1
